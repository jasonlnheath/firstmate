*/package-lock.json
yarn.lock
*/yarn.lock
pnpm-lock.yaml
*/pnpm-lock.yaml
Cargo.lock
*/Cargo.lock
Gemfile.lock
*/Gemfile.lock
poetry.lock
*/poetry.lock
Pipfile.lock
*/Pipfile.lock
composer.lock
*/composer.lock
go.sum
*/go.sum
bun.lockb
*/bun.lockb
bun.lock
*/bun.lock
deno.lock
*/deno.lock
flake.lock
*/flake.lock
uv.lock
*/uv.lock
mix.lock
*/mix.lock
packages.lock.json
*/packages.lock.json
packages.config
*/packages.config
Podfile.lock
*/Podfile.lock
Cartfile.resolved
*/Cartfile.resolved
conan.lock
*/conan.lock
gradle.lockfile
*/gradle.lockfile
cpanfile.snapshot
*/cpanfile.snapshot

# ---- Submodule pointers ----
.gitmodules
*/.gitmodules

